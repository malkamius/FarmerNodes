<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<Frame name="FarmerNodesWorldMapPinTemplate" hidden="true" enableMouse="true" mixin="FarmerNodesWorldMapPinMixin" virtual="true">
		<Size x="12" y="12"/>
		<Layers>
			<Layer level="OVERLAY">
				<Texture parentKey="texture" setAllPoints="true">
				</Texture>
			</Layer>
			<Layer level="OVERLAY" textureSubLevel="1">
				<FontString parentKey="countText" inherits="NumberFontNormalSmall" justifyH="RIGHT" justifyV="BOTTOM">
					<Anchors>
						<Anchor point="BOTTOMRIGHT" x="2" y="-2"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>
</Ui>
